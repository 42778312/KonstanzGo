# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Image tag to run (a server-v* release), or "local" to build here.
LIVE_TAG=local
# Port on 127.0.0.1 of the host.
HOST_PORT=8080

# trace, debug, info, notice, warning, error, critical
LOG_LEVEL=info
# Kill switch: false stops every request to EFA-BW within one cycle; the app then shows the timetable.
LIVE_UPSTREAM_ENABLED=true
# Hard cap on requests to EFA-BW per second. The server never goes above 1, whatever this says.
UPSTREAM_MAX_RPS=1
# Seconds between hub sweeps (at least 10).
POLL_INTERVAL_SECONDS=30
# Optional: comma-separated stop gids to poll instead of the computed hub list.
HUB_STOPS=
# Sent in the User-Agent so NVBW can reach you instead of blocking you.
CONTACT_EMAIL=
PUBLIC_URL=https://github.com/42778312/KonstanzGo
# Optional: require "Authorization: Bearer <token>" on /metrics.
METRICS_TOKEN=

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels). Only for the "tunnel" profile.
CLOUDFLARE_TUNNEL_TOKEN=
