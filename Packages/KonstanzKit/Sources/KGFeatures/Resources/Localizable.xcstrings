    "Bis zum Ziel fährt jetzt nichts anderes. Der aktuelle Weg bleibt dein bester.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing else runs to your destination right now. Your current route stays the best one."
          }
        }
