      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "KonstanzGo zeigt dir Haltestellen in deiner Nähe und den Fußweg dorthin. Dein Standort bleibt auf diesem iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "KonstanzGo shows you stops near you and the walk there. Your location stays on this iPhone."
